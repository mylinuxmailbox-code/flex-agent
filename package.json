{
  "name": "flex",
  "version": "0.1.0",
  "description": "Flex — an autonomous coding agent for your terminal.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "flex": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ansi-escapes": "^7.3.0",
    "chalk": "^6.0.0",
    "citty": "^0.2.2",
    "cli-truncate": "^6.1.1",
    "diff": "^9.0.0",
    "execa": "^10.0.1",
    "highlight.js": "^11.12.0",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "marked": "^18.0.14",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-ink-textarea": "^0.4.0",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.2.0",
    "wrap-ansi": "^10.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
